<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <Authors>NistParser Contributors</Authors>
    <Company>NistParser</Company>
    <Product>NistParser</Product>
    <Description>A .NET Standard 2.0 library for parsing ANSI/NIST-ITL biometric data interchange files. Supports Type-1 through Type-99 records including fingerprints, facial images, iris scans, palm prints, and more. Compatible with .NET Framework 4.6.1+, .NET Core 2.0+, and .NET 5+.</Description>
    <PackageProjectUrl>https://github.com/farkasaty/NistParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/farkasaty/NistParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>NIST;ANSI;biometric;fingerprint;facial-recognition;iris;palm-print;parser</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for System.Text.Json in .NET Standard 2.0 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
