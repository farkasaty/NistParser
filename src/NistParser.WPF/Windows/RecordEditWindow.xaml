<Window x:Class="NistParser.WPF.Windows.RecordEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editing="clr-namespace:NistParser.Editing;assembly=NistParser"
        xmlns:local="clr-namespace:NistParser.WPF.Windows"
        mc:Ignorable="d"
        Title="Edit Record" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:FieldTypeToTextBoxVisibilityConverter x:Key="TextBoxVisibilityConverter"/>
        <local:FieldTypeToComboBoxVisibilityConverter x:Key="ComboBoxVisibilityConverter"/>

        <!-- Style for section headers -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
        </Style>

        <!-- Style for field labels -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Style for required indicator -->
        <Style x:Key="RequiredIndicator" TargetType="TextBlock">
            <Setter Property="Text" Value="*"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>

        <!-- Style for help text -->
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Style for validation error -->
        <Style x:Key="ValidationError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel>
                <TextBlock Text="{Binding RecordTypeDisplayName}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Edit field values below. Required fields are marked with *"
                          FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Existing Fields Section -->
                <TextBlock Text="Fields" Style="{StaticResource SectionHeader}"/>

                <ItemsControl x:Name="FieldsItemsControl" ItemsSource="{Binding EditableFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                   Padding="15" Margin="0,0,0,10" Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Field Label -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="{Binding FieldNumber}" Foreground="#999" FontSize="11"
                                                  VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        <TextBlock Style="{StaticResource RequiredIndicator}"
                                                  Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <!-- Delete Button -->
                                    <Button Grid.Row="0" Grid.Column="1" Content="Delete" Width="100" Height="35"
                                           Click="DeleteField_Click" Tag="{Binding}"
                                           Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Input Control (TextBox for Text/Numeric/Date) -->
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Text="{Binding FieldValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            IsEnabled="{Binding IsEditable}"
                                            Margin="0,5,0,0" Padding="8">
                                        <TextBox.Visibility>
                                            <MultiBinding Converter="{StaticResource TextBoxVisibilityConverter}">
                                                <Binding Path="FieldType"/>
                                            </MultiBinding>
                                        </TextBox.Visibility>
                                    </TextBox>

                                    <!-- Input Control (ComboBox for Enum) -->
                                    <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                             SelectedValuePath="Key" DisplayMemberPath="Value"
                                             ItemsSource="{Binding EnumValues}"
                                             SelectedValue="{Binding FieldValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEditable}"
                                             Margin="0,5,0,0" Padding="8">
                                        <ComboBox.Visibility>
                                            <MultiBinding Converter="{StaticResource ComboBoxVisibilityConverter}">
                                                <Binding Path="FieldType"/>
                                            </MultiBinding>
                                        </ComboBox.Visibility>
                                    </ComboBox>

                                    <!-- Help Text -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                              Text="{Binding HelpText}" Style="{StaticResource HelpText}"
                                              Visibility="{Binding HelpText, Converter={StaticResource NullToVisibilityConverter}}"/>

                                    <!-- Validation Error -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                              Text="{Binding ValidationMessage}" Style="{StaticResource ValidationError}"
                                              Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add New Field Section -->
                <TextBlock Text="Add New Field" Style="{StaticResource SectionHeader}" Margin="0,25,0,10"/>

                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Field Selection -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Select Field:"
                                  Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                 ItemsSource="{Binding AvailableFieldsToAdd}"
                                 SelectedItem="{Binding SelectedFieldToAdd, Mode=TwoWay}"
                                 DisplayMemberPath="DisplayName"
                                 Padding="8" Margin="0,0,10,0"/>

                        <!-- Value Input -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Value:"
                                  Style="{StaticResource FieldLabel}" Margin="0,10,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                Text="{Binding NewFieldValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Padding="8" Margin="0,10,10,0"/>

                        <!-- Add Button -->
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="Add Field"
                               Width="100" Height="35" Click="AddField_Click"
                               IsEnabled="{Binding CanAddField}"
                               VerticalAlignment="Center"/>

                        <!-- Help Text for Selected Field -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                  Text="{Binding SelectedFieldToAdd.HelpText}"
                                  Style="{StaticResource HelpText}"
                                  Visibility="{Binding SelectedFieldToAdd.HelpText, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Changes" Width="120" Height="35" Click="Save_Click"
                       IsEnabled="{Binding IsValid}" Margin="0,0,10,0"/>
                <Button Content="Reset" Width="100" Height="35" Click="Reset_Click" Margin="0,0,10,0"/>
                <Button Content="Cancel" Width="100" Height="35" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
